; xinput1_4.def - export table for the xinput1_4.dll loader-hijack proxy.
;
; Ordinals and names mirror the real %WINDIR%\System32\xinput1_4.dll so
; callers that import by ordinal (notably Steam Big Picture, which reads
; the guide-button state via XInputGetStateEx at ordinal 100) resolve to
; our wrapper. NONAME on the six undocumented ordinals keeps their export
; table name-less, as on the system DLL.

LIBRARY "xinput1_4"
EXPORTS
    XInputEnable @5
    XInputGetAudioDeviceIds @10
    XInputGetBatteryInformation @7
    XInputGetCapabilities @4
    XInputGetKeystroke @8
    XInputGetState @2
    XInputSetState @3
    XInputOrdinal100 @100 NONAME
    XInputOrdinal101 @101 NONAME
    XInputOrdinal102 @102 NONAME
    XInputOrdinal103 @103 NONAME
    XInputOrdinal104 @104 NONAME
    XInputOrdinal108 @108 NONAME
